<html lang='en' style='margin:0;padding:0;'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Welcome to KickerGPT PRO - KickerGPT</title>
    <style>
      @media (max-width: 640px) {
        .email-container {
          width: 100% !important;
          margin: 0 !important;
          border-radius: 0 !important;
        }
      }
    </style>
  </head>
  <body
    style="margin:0;padding:0;background:#f5f7fb;font-family:'Segoe UI',Arial,sans-serif;color:#0f172a;"
  >
    <table
      role='presentation'
      cellpadding='0'
      cellspacing='0'
      width='100%'
      style='background:#f5f7fb;padding:32px 0;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            class='email-container'
            cellpadding='0'
            cellspacing='0'
            width='640'
            style='width:640px;max-width:640px;background:#ffffff;border-radius:16px;border:1px solid #e5e7eb;overflow:hidden;'
          >
            <tr>
              <td
                style='padding:28px 20px;text-align:center;border-bottom:1px solid #e5e7eb;'
              >
                <div
                  style='font-size:26px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;color:#111827;'
                >
                  KickerGPT
                </div>
                <div
                  style='margin-top:6px;font-size:12px;letter-spacing:0.28em;color:#6b7280;text-transform:uppercase;'
                >
                  Football intelligence
                </div>
              </td>
            </tr>

            <tr>
              <td
                style='padding:28px 32px 18px;line-height:1.6;font-size:15px;'
              >
                <p style='margin:0 0 12px;'>Hey {{name}},</p>
                <p style='margin:0 0 16px;'>
                  Welcome to
                  <strong>KickerGPT {{planName}}</strong>! 🎉
                </p>
                <p style='margin:0 0 20px;'>
                  Thank you for upgrading. You now have access to the full power
                  of KickerGPT
                  {{planDuration}}. Here's what you can do:
                </p>

                <div style='margin:20px 0;'>
                  <div
                    style='margin:0 0 18px;padding:20px;background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);border-radius:12px;text-align:center;color:#ffffff;'
                  >
                    <div
                      style='font-size:28px;font-weight:800;margin:0 0 8px;'
                    >⭐ {{planName}} Benefits</div>
                  </div>

                  {{#each features}}
                    <div
                      style='margin:0 0 18px;padding:16px;background:#f0fdf4;border-radius:8px;border-left:3px solid #10b981;'
                    >
                      <div
                        style='font-weight:600;color:#111827;margin:0 0 6px;'
                      >✅ {{this}}</div>
                    </div>
                  {{/each}}
                </div>

                <div
                  style='margin:24px 0;padding:20px;background:#f9fafb;border-radius:8px;border:1px solid #e5e7eb;'
                >
                  <div
                    style='font-weight:600;color:#111827;margin:0 0 12px;font-size:16px;'
                  >💡 Getting Started</div>
                  <div style='color:#4b5563;font-size:14px;line-height:1.6;'>
                    <strong>1. Check Your Predictions</strong><br />
                    Visit the Predictions section to see today's high-confidence
                    match predictions.<br /><br />
                    <strong>2. Ask Deep Questions</strong><br />
                    Use your
                    {{promptsDescription}}
                    to dive deep into match analysis, team strategies, and
                    player insights.<br /><br />
                    <strong>3. Explore All Features</strong><br />
                    Take advantage of extended match access, detailed analysis,
                    and all premium features.
                  </div>
                </div>

                <div
                  style='margin:24px 0;padding:20px;background:#eff6ff;border-radius:8px;border:1px solid #bfdbfe;text-align:center;'
                >
                  <div
                    style='color:#1e40af;font-size:16px;margin:0 0 12px;font-weight:600;'
                  >
                    Ready to get started?
                  </div>
                  <a
                    href='{{appUrl}}'
                    target='_blank'
                    rel='noopener'
                    style='display:inline-block;padding:12px 32px;background:#3b82f6;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;font-size:15px;'
                  >
                    Open KickerGPT
                  </a>
                </div>

                <p style='margin:20px 0 6px;color:#4b5563;font-size:14px;'>
                  If you have any questions or need help, just reply to this
                  email. We're here to help!
                </p>
                <p style='margin:0;font-weight:600;'>The KickerGPT Team</p>
              </td>
            </tr>

            <tr>
              <td
                style='padding:16px 28px;border-top:1px solid #e5e7eb;text-align:center;color:#6b7280;font-size:12px;line-height:1.6;'
              >
                <p style='margin:0 0 8px;'>
                  You're receiving this email because you upgraded to KickerGPT
                  {{planName}}.
                </p>
                <p style='margin:0 0 12px;'>
                  Need help? Reply to this email and we'll get back ASAP.
                </p>
                <a
                  href='{{unsubscribeUrl}}'
                  style='color:#4b5563;text-decoration:underline;'
                  target='_blank'
                  rel='noopener'
                >
                  Unsubscribe
                </a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>