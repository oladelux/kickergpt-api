<html lang='en' style='margin:0;padding:0;'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Password Reset Successful - KickerGPT</title>
    <style>
      @media (max-width: 640px) {
        .email-container {
          width: 100% !important;
          margin: 0 !important;
          border-radius: 0 !important;
        }
      }
    </style>
  </head>
  <body
    style="margin:0;padding:0;background:#f5f7fb;font-family:'Segoe UI',Arial,sans-serif;color:#0f172a;"
  >
    <table
      role='presentation'
      cellpadding='0'
      cellspacing='0'
      width='100%'
      style='background:#f5f7fb;padding:32px 0;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            class='email-container'
            cellpadding='0'
            cellspacing='0'
            width='640'
            style='width:640px;max-width:640px;background:#ffffff;border-radius:16px;border:1px solid #e5e7eb;overflow:hidden;'
          >
            <tr>
              <td
                style='padding:28px 20px;text-align:center;border-bottom:1px solid #e5e7eb;'
              >
                <div
                  style='font-size:26px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;color:#111827;'
                >
                  KickerGPT
                </div>
                <div
                  style='margin-top:6px;font-size:12px;letter-spacing:0.28em;color:#6b7280;text-transform:uppercase;'
                >
                  Football intelligence
                </div>
              </td>
            </tr>

            <tr>
              <td
                style='padding:28px 32px 18px;line-height:1.6;font-size:15px;'
              >
                <p style='margin:0 0 12px;'>Hey {{name}},</p>
                <p style='margin:0 0 20px;'>
                  Great news! Your password has been successfully reset.
                </p>

                <div
                  style='margin:20px 0;padding:20px;background:#f0fdf4;border-radius:12px;border-left:4px solid #10b981;'
                >
                  <div
                    style='font-weight:700;color:#111827;margin:0 0 10px;font-size:16px;display:flex;align-items:center;gap:8px;'
                  >
                    <span style='font-size:24px;'>✅</span>
                    Password Reset Successful
                  </div>
                  <div style='color:#4b5563;font-size:14px;line-height:1.7;'>
                    Your KickerGPT account password was changed successfully. All
                    active sessions have been logged out for security purposes.
                  </div>
                </div>

                <div
                  style='margin:20px 0;padding:18px;background:#eff6ff;border-radius:10px;border-left:4px solid #3b82f6;'
                >
                  <div
                    style='font-weight:700;color:#111827;margin:0 0 10px;font-size:15px;'
                  >🔒 Security Information</div>
                  <div style='color:#4b5563;font-size:14px;line-height:1.7;'>
                    <ul
                      style='margin:8px 0 0 20px;padding:0;color:#4b5563;font-size:14px;'
                    >
                      <li>All active sessions have been terminated</li>
                      <li>You'll need to sign in again with your new password</li>
                      <li>If you didn't make this change, please contact us immediately</li>
                    </ul>
                  </div>
                </div>

                <div
                  style='margin:24px 0;padding:20px;background:#fef3c7;border-radius:10px;border-left:4px solid #f59e0b;'
                >
                  <div
                    style='font-weight:700;color:#111827;margin:0 0 10px;font-size:15px;'
                  >💡 What's Next?</div>
                  <div style='color:#4b5563;font-size:14px;line-height:1.7;'>
                    You can now sign in to your account using your new password.
                    Make sure to keep your password secure and don't share it with
                    anyone.
                  </div>
                </div>

                <div
                  style='margin:24px 0;padding:22px;background:#f0fdf4;border-radius:10px;border:2px solid #10b981;text-align:center;'
                >
                  <div
                    style='color:#065f46;font-size:16px;margin:0 0 14px;font-weight:600;'
                  >
                    Ready to sign in?
                  </div>
                  <a
                    href='{{appUrl}}/sign-in'
                    target='_blank'
                    rel='noopener'
                    style='display:inline-block;padding:14px 40px;background:#10b981;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:700;font-size:16px;box-shadow:0 4px 6px rgba(16, 185, 129, 0.3);'
                  >
                    Sign In to KickerGPT
                  </a>
                </div>

                <p style='margin:20px 0 6px;color:#4b5563;font-size:14px;'>
                  If you didn't request this password reset, please contact our
                  support team immediately.
                </p>
                <p style='margin:0;font-weight:600;'>The KickerGPT Team</p>
              </td>
            </tr>

            <tr>
              <td
                style='padding:18px 28px;border-top:1px solid #e5e7eb;text-align:center;color:#6b7280;font-size:12px;line-height:1.6;'
              >
                <p style='margin:0 0 8px;'>
                  You're receiving this email because your password was recently
                  changed on KickerGPT.
                </p>
                <p style='margin:0 0 12px;'>
                  Need help? Reply to this email and we'll get back ASAP.
                </p>
                <a
                  href='{{unsubscribeUrl}}'
                  style='color:#4b5563;text-decoration:underline;'
                  target='_blank'
                  rel='noopener'
                >
                  Unsubscribe
                </a>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

