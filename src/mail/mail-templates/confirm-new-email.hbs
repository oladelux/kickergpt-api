<html lang='en' style='margin:0;padding:0;'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <title>{{title}}</title>
    <style>
      @media (max-width: 600px) {
        .email-container {
          width: 100% !important;
          margin: 0 !important;
          border-radius: 0 !important;
        }
      }
    </style>
  </head>

  <body
    style="margin:0;padding:0;background:#05060a;font-family:'Segoe UI',Arial,sans-serif;color:#f4f4f6;"
  >
    <table
      role='presentation'
      cellpadding='0'
      cellspacing='0'
      width='100%'
      style='background:#05060a;padding:32px 0;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            className='email-container'
            cellpadding='0'
            cellspacing='0'
            width='600'
            style='width:600px;max-width:600px;background:#0b0d14;border-radius:18px;border:1px solid rgba(255,255,255,0.06);overflow:hidden;'
          >
            <tr>
              <td
                style='padding:32px 24px;background:linear-gradient(120deg,#0f172a,#111c3d);text-align:center;'
              >
                <div
                  style='font-size:28px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#a3bffa;'
                >KickerGPT</div>
                <p
                  style='margin:14px 0 0;font-size:13px;letter-spacing:0.4em;color:rgba(255,255,255,0.6);text-transform:uppercase;'
                >Football intelligence</p>
              </td>
            </tr>

            <tr>
              <td
                style='padding:32px 40px 24px;color:#e1e3ea;line-height:1.6;font-size:15px;'
              >
                <p style='margin:0 0 16px;'>{{text1}}</p>
                <p style='margin:0 0 16px;'>{{text2}}</p>
                <p style='margin:0;'>{{text3}}</p>
              </td>
            </tr>

            <tr>
              <td style='padding:0 40px 40px;text-align:center;'>
                <a
                  href='{{url}}'
                  style='display:inline-block;padding:14px 32px;background:linear-gradient(135deg,#6366f1,#ec4899);color:#fff;text-decoration:none;font-weight:600;border-radius:999px;letter-spacing:0.05em;'
                >
                  {{actionTitle}}
                </a>
                <p
                  style='margin-top:20px;font-size:12px;color:rgba(255,255,255,0.5);'
                >
                  If the button doesn’t work, copy & paste this URL into your
                  browser:<br />
                  <span
                    style='word-break:break-all;color:rgba(255,255,255,0.7);'
                  >{{url}}</span>
                </p>
              </td>
            </tr>

            <tr>
              <td
                style='padding:24px 40px;background:#0b0d14;border-top:1px solid rgba(255,255,255,0.06);text-align:center;color:rgba(255,255,255,0.45);font-size:12px;'
              >
                You’re receiving this email because you requested to confirm
                your address on
                {{app_name}}.<br />
                Need help? Reply to this email and we’ll get back ASAP.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>